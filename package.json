{
  "name": "campus-resource-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent Campus Resource Reservation System - Production Grade",
  "scripts": {
    "dev": "pnpm --filter @campus/server dev & pnpm --filter @campus/client dev",
    "dev:server": "pnpm --filter @campus/server dev",
    "dev:client": "pnpm --filter @campus/client dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:generate": "pnpm --filter @campus/server prisma:generate",
    "db:push": "pnpm --filter @campus/server exec prisma db push",
    "db:seed": "pnpm --filter @campus/server exec prisma db seed",
    "test": "pnpm -r test:ci",
    "test:watch": "pnpm -r test:watch",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:regression": "pnpm run -r test:regression --filter=server",
    "test:e2e": "pnpm run -r test:e2e --filter=client",
    "test:performance": "pnpm run -r performance:test",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:regression && pnpm test:e2e",
    "test:epic3": "npm run test:epic3 --prefix server"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Campus Resource Engine Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "lucide-react": "^0.563.0"
  },
  "devDependencies": {
    "artillery": "^2.0.8"
  }
}
